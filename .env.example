# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/flowdao

# NextAuth configuration
NEXTAUTH_SECRET=generate-a-long-random-secret-here
NEXTAUTH_URL=http://localhost:3000

# Stellar Network configuration (testnet or public)
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_STELLAR_HORIZON=https://horizon-testnet.stellar.org
NEXT_PUBLIC_SOROBAN_RPC=https://soroban-testnet.stellar.org

# Security: 32-character key for DAO sensitive data encryption (AES-256-CBC)
DAO_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# Deployed DAO Contract ID (from Soroban deployment)
NEXT_PUBLIC_DAO_ID=CA... (your contract id)

# (Optional) Stellar Issuer/Treasury Management
# STELLAR_ISSUER_SECRET=S... (encrypted at rest if stored)
